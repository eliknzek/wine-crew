      "nullable": false,
      "max_unique": 750,
      "role": "feature"
    },
    {
      "name": "region_1",
      "dtype": "category",
      "nullable": true,
      "max_null_pct": 20,
      "role": "feature_optional"
    },
    {
      "name": "winery",
      "dtype": "string",
      "nullable": false,
      "role": "identifier"
    },
    {
      "name": "title",
      "dtype": "string",
      "nullable": false,
      "role": "identifier"
    },
    {
      "name": "designation",
      "dtype": "string",
      "nullable": true,
      "role": "excluded"
    },
    {
      "name": "description",
      "dtype": "string",
      "nullable": false,
      "role": "leakage"
    },
    {
      "name": "taster_name",
      "dtype": "category",
      "nullable": true,
      "role": "leakage"
    }
  ],
  "dropped_columns": [
    "region_2",
    "taster_twitter_handle"
  ],
  "forbidden_feature_roles": [
    "leakage",
    "identifier",
    "excluded",
    "target"
  ],
  "assumptions": [
    "Prices are in USD as listed by WineEnthusiast at review time (data scraped June 2017).",
    "points is the WineEnthusiast score; the source only publishes wines scored 80 or above.",
    "vintage is the first year between 1980 and 2017 found in title; non-vintage wines have no year.",
    "description and taster_name exist only after a wine is tasted, so they must never be model features."
  ],
  "constraints": [
    "No fully duplicated rows.",
    "No missing values in points, price, country or variety.",
    "Every column listed above exists with the stated dtype; no extra columns."
  ],
