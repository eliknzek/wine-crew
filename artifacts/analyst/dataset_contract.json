    {
      "name": "log_price",
      "dtype": "float64",
      "nullable": false,
      "derived_from": "price",
      "role": "feature"
    },
    {
      "name": "vintage",
      "dtype": "Int64",
      "nullable": true,
      "min": 1980,
      "max": 2017,
      "max_null_pct": 5,
      "derived_from": "title",
      "role": "feature"
    },
    {
      "name": "country",
      "dtype": "category",
      "nullable": false,
      "max_unique": 50,
      "role": "feature"
